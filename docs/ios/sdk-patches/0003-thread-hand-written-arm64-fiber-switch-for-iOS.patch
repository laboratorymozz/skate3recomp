diff --git a/src/core/fiber_arm64_apple.S b/src/core/fiber_arm64_apple.S
new file mode 100644
index 0000000..bdabe8f
--- /dev/null
+++ b/src/core/fiber_arm64_apple.S
@@ -0,0 +1,72 @@
+/**
+ * @file        rex/core/fiber_arm64_apple.S
+ * @brief       arm64 context switch backing rex::thread::Fiber on iOS
+ *
+ * getcontext/makecontext/swapcontext are unavailable in the iOS SDK, so the
+ * fiber primitive needs its own switch. This is data movement only - it saves
+ * and restores registers, it does not generate or modify code, so it needs no
+ * JIT entitlement and does not violate W^X.
+ *
+ * Only the AAPCS64 callee-saved state has to be preserved across the switch,
+ * because a switch always happens through a function call boundary and the
+ * caller has already spilled anything caller-saved it cares about:
+ *
+ *   x19-x28   callee-saved general purpose      80 bytes
+ *   x29, x30  frame pointer and link register   16 bytes
+ *   d8-d15    callee-saved SIMD (low 64 bits)   64 bytes
+ *                                              ---------
+ *                                              160 bytes, 16-byte aligned
+ *
+ * Keep the layout in sync with kFrameBytes and the slot offsets in
+ * fiber_ios.cpp, which fabricates one of these frames by hand to start a new
+ * fiber.
+ *
+ * This targets arm64, which is what apps are built for. It does not sign the
+ * return address, so it must not be assembled for arm64e without adding
+ * pacibsp/retab.
+ */
+
+#if defined(__aarch64__) || defined(__arm64__)
+
+.text
+.p2align 2
+.global _rex_fiber_switch
+
+// void rex_fiber_switch(void** save_sp, void* restore_sp);
+//   x0 = where to store the outgoing stack pointer
+//   x1 = stack pointer to resume
+_rex_fiber_switch:
+    sub     sp, sp, #160
+    stp     x19, x20, [sp, #0]
+    stp     x21, x22, [sp, #16]
+    stp     x23, x24, [sp, #32]
+    stp     x25, x26, [sp, #48]
+    stp     x27, x28, [sp, #64]
+    stp     x29, x30, [sp, #80]
+    stp     d8,  d9,  [sp, #96]
+    stp     d10, d11, [sp, #112]
+    stp     d12, d13, [sp, #128]
+    stp     d14, d15, [sp, #144]
+
+    // Hand the outgoing context back to the caller, then adopt the incoming one.
+    mov     x2, sp
+    str     x2, [x0]
+    mov     sp, x1
+
+    ldp     x19, x20, [sp, #0]
+    ldp     x21, x22, [sp, #16]
+    ldp     x23, x24, [sp, #32]
+    ldp     x25, x26, [sp, #48]
+    ldp     x27, x28, [sp, #64]
+    ldp     x29, x30, [sp, #80]
+    ldp     d8,  d9,  [sp, #96]
+    ldp     d10, d11, [sp, #112]
+    ldp     d12, d13, [sp, #128]
+    ldp     d14, d15, [sp, #144]
+    add     sp, sp, #160
+
+    // Returns into the restored x30: either the point the target last switched
+    // from, or Trampoline for a fiber being started for the first time.
+    ret
+
+#endif  // __aarch64__ || __arm64__
diff --git a/src/core/fiber_ios.cpp b/src/core/fiber_ios.cpp
new file mode 100644
index 0000000..68e9fb1
--- /dev/null
+++ b/src/core/fiber_ios.cpp
@@ -0,0 +1,99 @@
+/**
+ * @file        rex/core/fiber_ios.cpp
+ * @brief       iOS backend for rex::thread::Fiber
+ *
+ * @copyright   Copyright (c) 2026 Tom Clay <tomc@tctechstuff.com>
+ *              All rights reserved.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * The ucontext family that fiber_posix.cpp is built on is deprecated on macOS
+ * and absent from the iOS SDK, so iOS switches contexts with the hand-written
+ * arm64 routine in fiber_arm64_apple.S. Semantics are identical to the POSIX
+ * backend: Trampoline reads entry_/arg_ from tls_current_, which SwitchTo sets
+ * before switching.
+ */
+
+#include <rex/platform.h>
+#if REX_PLATFORM_IOS
+
+#include <rex/thread/fiber.h>
+
+#include <cassert>
+#include <cstdint>
+#include <cstring>
+
+extern "C" void rex_fiber_switch(void** save_sp, void* restore_sp);
+
+namespace rex::thread {
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+namespace {
+
+// Must match the frame written by rex_fiber_switch in fiber_arm64_apple.S.
+constexpr size_t kFrameBytes = 160;
+constexpr size_t kSlotX29 = 80;
+constexpr size_t kSlotX30 = 88;
+
+}  // namespace
+
+Fiber* Fiber::ConvertCurrentThread() {
+  // Nothing to capture up front: the running context is written into sp_ by the
+  // first SwitchTo away from this fiber.
+  auto* f = new Fiber();
+  f->is_thread_fiber_ = true;
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size);
+
+  // Fabricate the frame rex_fiber_switch expects to pop, so that the first
+  // switch to this fiber returns straight into Trampoline on the new stack.
+  uintptr_t top = reinterpret_cast<uintptr_t>(f->stack_.data()) + f->stack_.size();
+  top &= ~uintptr_t(15);  // AAPCS64 requires a 16-byte aligned sp
+  uintptr_t frame = top - kFrameBytes;
+
+  auto* slots = reinterpret_cast<uint8_t*>(frame);
+  std::memset(slots, 0, kFrameBytes);
+  // A null frame pointer terminates backtraces at the base of the fiber stack
+  // rather than running off into unrelated memory.
+  *reinterpret_cast<void**>(slots + kSlotX29) = nullptr;
+  *reinterpret_cast<void**>(slots + kSlotX30) = reinterpret_cast<void*>(&Fiber::Trampoline);
+
+  f->sp_ = reinterpret_cast<void*>(frame);
+  return f;
+}
+
+/*static*/ void Fiber::Trampoline() {
+  // tls_current_ was updated by SwitchTo before the switch landed here.
+  Fiber* f = tls_current_;
+  f->entry_(f->arg_);
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  tls_current_ = target;
+  rex_fiber_switch(&from->sp_, target->sp_);
+}
+
+void Fiber::Destroy() {
+  // Thread fibers are destroyed from the owning thread itself.
+  if (is_thread_fiber_) {
+    tls_current_ = nullptr;
+  } else {
+    assert(this != tls_current_ && "Destroy called on the currently running fiber");
+  }
+  // stack_ is freed by the vector destructor.
+  delete this;
+}
+
+}  // namespace rex::thread
+
+#endif  // REX_PLATFORM_IOS
